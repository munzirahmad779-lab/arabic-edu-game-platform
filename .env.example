# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Public — safe to expose to the browser (Supabase enforces access via RLS,
# not by keeping these values secret).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import in a "use client"
# file, never send to the browser. Not used anywhere in Phase 1 code. Reserved
# for a future phase that needs privileged/service-role access (e.g. an admin
# script or a server-only RPC helper that must bypass RLS deliberately).
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
