# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Public — safe to expose to the browser (Supabase enforces access via RLS,
# not by keeping these values secret).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Email tunggal yang memiliki akses Super Admin.
SUPER_ADMIN_EMAIL=munzirahmad779@gmail.com

# Server-only — NEVER prefix with NEXT_PUBLIC_, never import in a "use client"
# file, never send to the browser. Dipakai route /api/grade-essay (server)
# untuk membaca submission esai dan menulis skor AI lewat RPC
# student_set_ai_grade pada konteks service_role (gerbang migrasi 0084),
# sesudah route memeriksa wewenang pemanggil (guru pemilik tugas atau
# siswa pemilik submission). Wajib diisi di server produksi; tanpa kunci
# ini penilaian esai AI menjawab galat 500 yang tercatat di log.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
